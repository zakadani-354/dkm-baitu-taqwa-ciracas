{
  "functions": {
    "public/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.php"
    },
    {
      "src": "/([a-z]+)\\.php",
      "dest": "/public/$1.php"
    }
  ]
}
