{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/favicon\\.ico$",
      "dest": "/api/favicon.php"
    },
    {
      "src": "^/favicon\\.svg$",
      "dest": "/api/favicon.php"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "src": "/(index|login|logout|dashboard|jamaah|presensi|kegiatan|ceklist)\\.php",
      "dest": "/api/$1.php"
    }
  ]
}
